    {
      "name": "Positive Login Scenario",
      "item": [
        {
          "name": "GET Login Page / Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('Content-Type header is present', () => {",
                  "    pm.response.to.have.header('Content-Type');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => {\n    pm.response.to.have.status(200);\n});\n\nlet jsonData;\npm.test('Response is valid JSON', () => {\n    jsonData = pm.response.json();\n    pm.expect(jsonData).to.be.an('object');\n});\n\npm.test('Auth token is present and valid', () => {\n    pm.expect(jsonData.token).to.not.be.undefined;\n    pm.expect(jsonData.token).to.not.be.empty;\n    pm.collectionVariables.set('authToken', jsonData.token);\n});\n\npm.test('Token looks like a JWT', () => {\n    pm.expect(jsonData.token).to.match(/^[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+\\.[A-Za-z0-9-_]+$/);\n});\n\npm.test('Username matches logged-in user', () => {\n    pm.expect(jsonData.username).to.eql(pm.collectionVariables.get('validUsername'));\n});\n\npm.test('Role field is present', () => {\n    pm.expect(jsonData.role).to.not.be.undefined;\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{validUsername}}\",\n  \"password\": \"{{validPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "html"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Dashboard - After Valid Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let jsonData;",
                  "pm.test('Response is valid JSON', () => {",
                  "    jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('Dashboard contains expected stat fields', () => {",
                  "    pm.expect(jsonData.totalUsers).to.not.be.undefined;",
                  "    pm.expect(jsonData.opportunity).to.not.be.undefined;",
                  "    pm.expect(jsonData.contact).to.not.be.undefined;",
                  "    pm.expect(jsonData.company).to.not.be.undefined;",
                  "});",
                  "",
                  "pm.test('totalUsers count is a number', () => {",
                  "    pm.expect(jsonData.totalUsers.count).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/crm-dashboard?startDate=2025-12-31&endDate=2026-12-30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crm-dashboard"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2025-12-31"
                },
                {
                  "key": "endDate",
                  "value": "2026-12-30"
                }
              ]
            }
          },
          "response": []
        }
      ]
