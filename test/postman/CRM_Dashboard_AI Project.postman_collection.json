    {
      "name": "Positive Company Scenario",
      "item": [
        {
          "name": "Create Company - Valid Data (Nova Tech Solutions)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code indicates success (200 or 201)', function () {\n    pm.expect([200, 201]).to.include(pm.response.code);\n});\n\npm.test('Response has an id (company created)', function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.id).to.be.a('number');\n});\n\npm.test('Created company has correct name', function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.companyName).to.eql('Nova Tech Solutions');\n});\n\npm.test('Created company has correct details', function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.industryId).to.eql(pm.collectionVariables.get('industry_id') ? Number(pm.collectionVariables.get('industry_id')) : jsonData.industryId);\n    pm.expect(jsonData.companyTypeId).to.be.a('number');\n    pm.expect(jsonData.phone).to.eql('+91 9845012345');\n    pm.expect(jsonData.website).to.eql('https://www.novatech.com');\n});\n\npm.test('createdAt and updatedAt are present', function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.createdAt).to.exist;\n    pm.expect(jsonData.updatedAt).to.exist;\n});\n\nif ([200, 201].includes(pm.response.code)) {\n    const jsonData = pm.response.json();\n    pm.collectionVariables.set('company_id', jsonData.id);\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Nova Tech Solutions\",\n  \"industryId\": 18,\n  \"companyTypeId\": 1,\n  \"companySize\": null,\n  \"annualRevenue\": null,\n  \"website\": \"https://www.novatech.com\",\n  \"phone\": \"+91 9845012345\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/company",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "company"
              ]
            },
            "description": "Corresponds to: entering Company Information (Name, Industry, Company Type, Website, Phone), proceeding through Billing Information step, and submitting to create the company.\n\nNOTE: industryId 18 and companyTypeId 1 were captured from a live test ('Information Technology' / a sample type) in this CRM instance's dropdowns. If your instance's IDs differ for 'Information Technology and Services' / 'Private', look them up via the industry/company-type list endpoints (seen in your Network tab as 'industry?query=all' and 'company-type?query=all') and update these values."
          },
          "response": []
        },
        {
          "name": "Verify Company Appears in Company List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {\n    pm.response.to.have.status(200);\n});\n\npm.test('Company list contains Nova Tech Solutions', function () {\n    const jsonData = pm.response.json();\n    const list = jsonData.getAllCompany || (Array.isArray(jsonData) ? jsonData : (jsonData.data || jsonData.items || []));\n    const found = list.some(company => company.companyName === 'Nova Tech Solutions');\n    pm.expect(found).to.be.true;\n});\n\npm.test('Listed company has matching details', function () {\n    const jsonData = pm.response.json();\n    const list = jsonData.getAllCompany || (Array.isArray(jsonData) ? jsonData : (jsonData.data || jsonData.items || []));\n    const company = list.find(c => c.companyName === 'Nova Tech Solutions');\n    pm.expect(company).to.not.be.undefined;\n    pm.expect(company.phone).to.eql('+91 9845012345');\n    pm.expect(company.website).to.eql('https://www.novatech.com');\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/company?status=true&page=1&count=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "company"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "count",
                  "value": "10"
                }
              ]
            },
            "description": "Corresponds to: 'Nova Tech Solutions' appears in the Company list on the Company page with the details entered.\n\nNOTE: this is the same listing endpoint your app calls to load the grid (captured from your Network tab). It doesn't support a 'search' query param directly in what was observed — the test script scans the returned page for the match instead. If your list is paginated and Nova Tech Solutions isn't on page 1, increase 'count' or loop through pages."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Negative Company Scenario",
      "item": [
        {
          "name": "Create Company - Missing Company Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code indicates validation failure (400 or 422)', function () {\n    pm.expect([400, 422]).to.include(pm.response.code);\n});\n\npm.test('Response body indicates a validation error', function () {\n    const jsonData = pm.response.json();\n    const bodyStr = JSON.stringify(jsonData).toLowerCase();\n    pm.expect(bodyStr).to.satisfy(str =>\n        str.includes('companyname') || str.includes('company name') || str.includes('required'),\n    'Expected error response to reference the missing companyName field');\n});\n\npm.test('Company is not created (no id returned)', function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData.id).to.be.undefined;\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
